// Cloudflare Workers static-assets config. The site is fully static:
// `python3 build.py` writes dist/, and `npx wrangler deploy` uploads it.
// "name" must match the Worker's name in the Cloudflare dashboard.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pdfshrink",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
